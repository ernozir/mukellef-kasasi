{
  "manifest_version": 3,
  "name": "Mükellef Kasası",
  "short_name": "Mükellef Kasası",
  "version": "1.2.0",
  "description": "Dijital Vergi Dairesi giriş bilgilerini şifreli bir kasada saklar, girişi tek tıkla doldurur; İnternet Vergi Dairesi'nde beyannameleri listeleyip toplu indirir.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mükellef Kasası",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://dijital.gib.gov.tr/*", "https://intvrg.gib.gov.tr/*"],
  "content_scripts": [
    {
      "matches": ["https://dijital.gib.gov.tr/portal/login*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
